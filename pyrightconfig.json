{
  "include": [
    ".",
    "**/*.py",
    ".claude/hooks",
    "scripts",
    "plugins"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".git",
    ".github",
    ".superpowers",
    ".claude/worktrees",
    ".ruff_cache"
  ],
  "typeCheckingMode": "all",
  "pythonVersion": "3.15",
  "executionEnvironments": [
    {
      "root": "plugins",
      "pythonVersion": "3.12"
    }
  ],
  "pythonPlatform": "All",
  "deprecateTypingAliases": true,
  "enableExperimentalFeatures": true
}
