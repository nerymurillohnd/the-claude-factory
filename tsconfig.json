{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "nodenext",
    "target": "es2023",
    "types": ["node"]
  },
  "include": ["scripts/**/*", "plugins/*/**/*.mjs", "plugins/*/**/*.cjs", "plugins/*/**/*.js"],
  "exclude": ["**/node_modules", "plugins/*/workflows"]
}
