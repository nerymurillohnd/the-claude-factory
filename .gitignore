# OS
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*

# Local Claude Code state (personal, never committed)
.claude/settings.local.json
.claude/worktrees/
.claude/plans/
CLAUDE.local.md

# Agent scratch workspaces (superpowers plans and ledgers)
.superpowers/

# Scratch
tmp/
*.log
actionlint

# Plugin eval results
**/evals/results/

# The tsconfig.json Claude Code writes at a mod's root for the editor, beside the git-ignored
# .claude-plugin/types/ it extends; it would ship to users for nothing
plugins/*/tsconfig.json

# Python
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
eval-results/

# Claude Code auto memory (machine-local)
.claude/memory/

# Session handoffs (machine-local; they can hold personal and cross-project notes)
.claude/session-handoff/
