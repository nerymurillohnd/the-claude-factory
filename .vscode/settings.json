{
  // --- Files: the same rules as .editorconfig, for editors and saves that bypass it ---
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  // package-lock.json: the repository runs npm only.
  "npm.packageManager": "npm",

  // A workspace `js/ts.tsdk.path` doesn't switch the compiler by itself, so the prompt below
  // stays on. VS Code's description: "When specified as a workspace setting, `js/ts.tsdk.path`
  // allows you to switch to use that workspace version of TypeScript for IntelliSense with the
  // `TypeScript: Select TypeScript version` command." Until someone accepts that prompt, the
  // editor types against VS Code's built-in compiler.
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  // The pinned TypeScript 6 above, never the native TypeScript 7 preview.
  "js/ts.experimental.useTsgo": false,
  // Auto-imports of types use import type, which Biome's useImportType requires.
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.useAliasesForRenames": true,
  // Errors of every file in each project, not only the open ones, as tsc --noEmit reports them.
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  // Headroom for project-wide diagnostics; tsserver's default is 3072 MB.
  "js/ts.tsserver.maxMemory": 8192,
  "js/ts.suggest.autoImports": true,
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.implementationsCodeLens.enabled": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.updateImportsOnPaste.enabled": true,

  // --- Biome: on save, the editor does what npm run format and biome ci do ---
  // biome.jsonc's lineWidth.
  "editor.rulers": [
    100
  ],
  // Biome runs only under biome.jsonc, with the pinned node_modules binary found first, as
  // npm run does. So biome.lsp.bin and biome.configurationPath stay unset: either would make the
  // editor run another binary or configuration than npm run.
  // requireConfiguration takes effect only with biome.enabled true in the same scope.
  "biome.enabled": true,
  "biome.requireConfiguration": true,
  "biome.suggestInstallingGlobally": false,
  // Auto-imports in Biome's quote style, so saving causes no churn.
  "js/ts.preferences.quoteStyle": "single",
  // Biome is the formatter of every language it checks here, whatever the user settings say. Each
  // block repeats the suppression "never"s, since a language block may replace the top-level list.
  // Biome sorts imports; tsserver removes unused ones on save, because Biome's noUnusedImports fix
  // is unsafe and source.fixAll.biome applies only safe fixes.
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.suppressRule.inline.biome": "never",
      "source.suppressRule.topLevel.biome": "never",
      "source.organizeImports.biome": "explicit",
      "source.removeUnusedImports": "explicit",
      "source.organizeImports": "never"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.suppressRule.inline.biome": "never",
      "source.suppressRule.topLevel.biome": "never",
      "source.organizeImports.biome": "explicit",
      "source.removeUnusedImports": "explicit",
      "source.organizeImports": "never"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.suppressRule.inline.biome": "never",
      "source.suppressRule.topLevel.biome": "never",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.suppressRule.inline.biome": "never",
      "source.suppressRule.topLevel.biome": "never",
      "source.organizeImports.biome": "explicit"
    }
  },
  // Markdown and YAML: Biome leaves its excluded files untouched.
  "[markdown]": {
    // .editorconfig keeps trailing whitespace in Markdown, where two spaces end a line.
    "files.trimTrailingWhitespace": false,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.suppressRule.inline.biome": "never",
      "source.suppressRule.topLevel.biome": "never"
    }
  },
  "[yaml]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.suppressRule.inline.biome": "never",
      "source.suppressRule.topLevel.biome": "never"
    }
  },
  // Assist runs on save only for the actions biome.jsonc enables. Each
  // action biome.jsonc turns on later switches from "never" to "explicit" in the same commit.
  // Suppression comments are written by hand, with a reason, never on save.
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit",
    "source.action.useSortedPackageJson.biome": "explicit",
    "source.action.noDuplicateClasses.biome": "explicit",
    "source.action.useSortedAttributes.biome": "explicit",
    "source.suppressRule.inline.biome": "never",
    "source.suppressRule.topLevel.biome": "never"
  },
  // VS Code validates each JSON file against the schema its $schema names, downloaded when it is a
  // URL. The SchemaStore claude-code-settings schema of .claude/settings.json often lags Claude
  // Code: a field it flags as unknown is checked against the official docs, never dropped on its
  // word alone.
  "json.validate.enable": true,
  "json.schemaDownload.enable": true,
  // Outline and folding for large JSON files, such as schemas; the default is 5000.
  "json.maxItemsComputed": 10000,
  // The repository has no ESLint, Prettier or markdownlint configuration; Biome lints and formats.
  "eslint.enable": false,
  "prettier.enable": false,
  "markdownlint.appliesTo": "noFiles",

  // --- Ruff: on save, the editor does what npm run format and npm run lint:python do ---
  // No ruff.path: the extension looks in the active Python environment, then on PATH, where the
  // ruff that tools:install pins lives, and uses its bundled copy only when neither has one.
  "ruff.importStrategy": "fromEnvironment",
  // ruff.toml decides, as for the CLI; no ruff.lint.* or ruff.lineLength setting here.
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.lint.enable": true,
  "ruff.fixAll": true,
  "ruff.organizeImports": true,
  "ruff.showSyntaxErrors": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    // Ruff sorts imports with ruff.toml's isort settings; basedpyright's sort stays off.
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit",
      "source.organizeImports": "never"
    }
  },

  // --- Core language server controls ---
  "basedpyright.disableLanguageServices": false,
  "basedpyright.disableOrganizeImports": false,
  "basedpyright.disableTaggedHints": false,

  // --- Analysis settings ---
  "basedpyright.analysis.autoImportCompletions": true,
  "basedpyright.analysis.autoSearchPaths": true,
  "basedpyright.analysis.diagnosticMode": "workspace",
  "basedpyright.analysis.logLevel": "Information",

  // Inlay hints (basedpyright-exclusive)
  "basedpyright.analysis.inlayHints.variableTypes": true,
  "basedpyright.analysis.inlayHints.callArgumentNames": true,
  "basedpyright.analysis.inlayHints.functionReturnTypes": true,
  "basedpyright.analysis.inlayHints.genericTypes": false,
  // Type checking is configured in pyrightconfig.json and scripts/pyrightconfig.json only, as
  // basedpyright's docs recommend, so the editor checks what the basedpyright CLI checks.

  // --- Python environment: the .venv that uv run creates (pyproject.toml, uv.lock) ---
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // basedpyright is the only Python language server.
  "python.languageServer": "None",
  // The venv manager, which also covers environments uv creates.
  "python-envs.defaultEnvManager": "ms-python.python:venv"
}
