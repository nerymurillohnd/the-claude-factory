{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,md,yml,yaml}",
      "!!**/dist",
      "!!**/build",
      "!!.claude/worktrees",
      "!!.superpowers",
      "!!.github",
      "!!.claude/settings.local.json",
      "!.claude/skills/building-plugins/assets/plugin-template.json",
      "!!**/package-lock.json",
      "!**/CLAUDE.md",
      "!.claude/memory",
      "!.claude/session-handoff",
      "!.claude/maintainer",
      "!.claude/plans",
      "!.claude/specs",
      "!.claude/rules",
      "!.claude/skills/**/*.md",
      "!plugins/**/*.md"
    ]
  },
  "formatter": {
    "lineWidth": 100,
    "useEditorconfig": true
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "off",
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noChildrenProp": "error"
      },
      "complexity": {
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error"
      },
      "performance": {
        "noDelete": "error"
      },
      "style": {
        "noImplicitBoolean": "error",
        "noNegationElse": "off",
        "noParameterAssign": "warn",
        "noRestrictedGlobals": "error",
        "noShoutyConstants": "warn",
        "noUnusedTemplateLiteral": "warn",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "warn",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useExponentiationOperator": "error",
        "useNumberNamespace": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "warn",
        "useConsistentArrayType": "error",
        "useForOf": "error",
        "useImportType": "error",
        "useNamingConvention": "warn"
      },
      "suspicious": {
        "noCatchAssign": "error",
        "noConsole": "warn",
        "noEmptyBlockStatements": "error",
        "noExtraNonNullAssertion": "error",
        "noPrototypeBuiltins": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "warn",
        "useAdjacentOverloadSignatures": "error"
      },
      "nursery": {
        "useExplicitType": "warn",
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSingleTopLevelHeading": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    },
    "parser": {
      "jsxEverywhere": false
    }
  },
  "json": {
    "formatter": {
      "expand": "always"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/tests/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noImplicitBoolean": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/tsconfig.json",
        "**/tsconfig.*.json"
      ],
      "json": {
        "formatter": {
          "expand": "auto"
        }
      }
    }
  ]
}
