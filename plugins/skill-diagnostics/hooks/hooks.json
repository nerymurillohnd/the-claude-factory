{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/SKILL.md)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/skill_written.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Edit(**/SKILL.md)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/skill_written.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
