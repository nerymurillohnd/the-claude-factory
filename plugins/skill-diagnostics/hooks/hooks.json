{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(//**/SKILL.md)",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill_written.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Edit(//**/SKILL.md)",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/skill_written.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
