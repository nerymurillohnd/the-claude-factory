          "category",
          "severity",
          "confidence",
          "sid",
          "line_start",
          "line_end",
          "excerpt",
          "conflicts_with",
          "evidence",
          "ladder",
          "impact",
          "disposition",
          "rationale",
          "related",
          "target",
          "replacement",
          "topics"
