              "accept",
              "revise",
              "dismiss"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "keep",
              "remove",
              "merge",
              "move",
              "revise",
              "investigate"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "pairs": {
      "type": "array",
