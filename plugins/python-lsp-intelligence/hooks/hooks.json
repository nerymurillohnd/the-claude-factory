{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check.py\"",
            "timeout": 60,
            "statusMessage": "python-lsp-intelligence: ruff check --fix, ruff format and basedpyright on the changed Python files"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check.py\"",
            "timeout": 60,
            "statusMessage": "python-lsp-intelligence: ruff check --fix, ruff format and basedpyright on the changed Python files"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
