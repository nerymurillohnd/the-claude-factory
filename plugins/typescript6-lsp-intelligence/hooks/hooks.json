{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tsc-check.sh\"",
            "timeout": 120,
            "onFailure": "block",
            "statusMessage": "typescript6-lsp-intelligence: tsc --noEmit --pretty false --strict"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tsc-check.sh\"",
            "timeout": 120,
            "onFailure": "block",
            "statusMessage": "typescript6-lsp-intelligence: tsc --noEmit --pretty false --strict"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tsc-check.sh\"",
            "timeout": 120,
            "onFailure": "block",
            "statusMessage": "typescript6-lsp-intelligence: tsc --noEmit --pretty false --strict"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/typescript6-lsp-skill-instructions.txt\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tsc-check.sh\" --new-turn",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
