{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/tsc-check.mjs\"",
            "timeout": 120,
            "onFailure": "block",
            "statusMessage": "typescript6-lsp-intelligence: tsc --noEmit on the changed TypeScript and JavaScript files"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/typescript6-lsp-skill-instructions.txt\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
