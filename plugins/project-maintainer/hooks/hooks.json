{
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-bootstrap.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for a session handoff"
          }
        ]
      }
    ]
  }
}
