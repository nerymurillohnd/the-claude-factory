{
  "svelte": {
    "command": "svelteserver",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".svelte": "svelte"
    },
    "startupTimeout": 60000,
    "shutdownTimeout": 15000,
    "restartOnCrash": true,
    "maxRestarts": 3,
    "diagnostics": true,
    "initializationOptions": {
      "tsserver": {
        "useSyntaxServer": "never"
      }
    }
  }
}

