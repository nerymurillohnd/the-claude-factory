{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/check.mjs"
            ],
            "timeout": 120,
            "statusMessage": "typescript7-lsp-intelligence: tsc --noEmit on the program of each changed TypeScript/JavaScript file"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/check.mjs"
            ],
            "timeout": 120,
            "statusMessage": "typescript7-lsp-intelligence: tsc --noEmit on the program of each changed TypeScript/JavaScript file"
          }
        ]
      }
    ]
  }
}
