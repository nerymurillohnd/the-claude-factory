{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check.mjs\"",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "bash-lsp-intelligence: shfmt and shellcheck on the changed shell scripts",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check.mjs\"",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "bash-lsp-intelligence: shfmt and shellcheck on the changed shell scripts",
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-lsp-skill-instructions.txt\"",
            "shell": "bash",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
