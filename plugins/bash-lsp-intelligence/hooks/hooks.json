{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-stamp.sh"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/shfmt-shellcheck.sh"],
            "timeout": 60,
            "statusMessage": "shfmt + shellcheck"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/shfmt-shellcheck.sh"],
            "timeout": 120,
            "statusMessage": "shfmt + shellcheck on changed shell files"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/shfmt-shellcheck.sh"],
            "timeout": 120,
            "statusMessage": "shfmt + shellcheck on changed shell files"
          }
        ]
      }
    ]
  }
}
