{
  "name": "the-claude-factory-maintainer",
  "private": true,
  "description": "Maintainer tooling for The Claude Factory marketplace. Not published.",
  "homepage": "https://github.com/nerymurillohnd/the-claude-factory#readme",
  "bugs": {
    "url": "https://github.com/nerymurillohnd/the-claude-factory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerymurillohnd/the-claude-factory.git"
  },
  "license": "MIT",
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run check:consistency && npm run validate",
    "check:consistency": "uv run python -m scripts.checks.plugin_consistency.cli",
    "check:install": "bash scripts/release/check-install.sh",
    "check:links": "bash scripts/checks/live-urls.sh",
    "check:pr": "bash scripts/checks/pr-checks.sh",
    "check:staged": "bash scripts/checks/pre-commit-gate.sh",
    "fix": "npm run fix:biome && npm run fix:ruff && npm run format:ruff && npm run format:shfmt",
    "fix:biome": "biome check --write .",
    "fix:ruff": "ruff check --fix .",
    "format": "npm run format:biome && npm run format:ruff && npm run format:shfmt",
    "format:biome": "biome format --write .",
    "format:ruff": "ruff format .",
    "format:shfmt": "shfmt -w .",
    "icons:render": "node scripts/generators/plugin-icons.mjs",
    "labels:sync": "uv run python -m scripts.generators.labels",
    "lint": "npm run lint:js && npm run lint:agents && npm run lint:python && npm run lint:shell && npm run lint:workflows && npm run lint:github",
    "lint:actionlint": "actionlint",
    "lint:agents": "uv run python -m scripts.checks.agent_headings.cli",
    "lint:dependabot": "check-jsonschema --builtin-schema vendor.dependabot .github/dependabot.yml",
    "lint:frontmatter": "uv run python -m scripts.checks.frontmatter_lint.cli",
    "lint:github": "npm run lint:github-forms && npm run lint:github-config && npm run lint:dependabot && npm run lint:github-files",
    "lint:github-config": "check-jsonschema --builtin-schema vendor.github-issue-config .github/ISSUE_TEMPLATE/config.yml",
    "lint:github-files": "uv run python -m scripts.checks.github_files",
    "lint:github-forms": "check-jsonschema --builtin-schema vendor.github-issue-forms .github/ISSUE_TEMPLATE/bug_report.yml .github/ISSUE_TEMPLATE/docs_issue.yml .github/ISSUE_TEMPLATE/feature_request.yml .github/ISSUE_TEMPLATE/plugin_idea.yml .github/ISSUE_TEMPLATE/question.yml .github/VULNERABILITY_REPORT.yml",
    "lint:js": "biome check --error-on-warnings --max-diagnostics=none .",
    "lint:python": "npm run lint:ruff && npm run lint:ruff-format",
    "lint:ruff": "ruff check .",
    "lint:ruff-format": "ruff format --check .",
    "lint:shell": "npm run lint:shellcheck && npm run lint:shfmt",
    "lint:shellcheck": "shfmt -f . | xargs shellcheck -S style -a",
    "lint:shfmt": "shfmt -d .",
    "lint:skills": "uv run python -m scripts.checks.skill_lint.cli",
    "lint:workflows": "npm run lint:actionlint && npm run lint:zizmor",
    "lint:zizmor": "zizmor --offline .",
    "prepare": "bash scripts/checks/install-git-hooks.sh",
    "release:changelog": "uv run python -m scripts.release.changelog",
    "release:notes": "uv run python -m scripts.release.notes",
    "release:publish": "bash scripts/release/publish-releases.sh",
    "release:status": "uv run python -m scripts.release.status",
    "setup": "npm run setup:node && npm run setup:plugins && npm run setup:python && npm run tools:install",
    "setup:node": "npm ci",
    "setup:plugins": "bash scripts/checks/plugins.sh install",
    "setup:python": "uv sync --locked",
    "test:plugins": "bash scripts/checks/plugins.sh tests",
    "test:scripts": "uv run python -m unittest discover -s scripts/tests -t . -p 'test_*.py'",
    "tools:basedpyright": "uv tool install basedpyright==1.40.2",
    "tools:check-jsonschema": "uv tool install check-jsonschema==0.39.0",
    "tools:install": "npm run tools:ruff && npm run tools:basedpyright && npm run tools:zizmor && npm run tools:check-jsonschema",
    "tools:ruff": "uv tool install ruff==0.17.5",
    "tools:zizmor": "uv tool install zizmor==1.32.0",
    "typecheck": "npm run typecheck:ts && npm run typecheck:python",
    "typecheck:python": "basedpyright",
    "typecheck:ts": "tsc -p tsconfig.json",
    "validate": "npm run validate:plugins && npm run validate:marketplace && npm run validate:claude && npm run validate:portable && npm run validate:hooks-catch && npm run validate:mods",
    "validate:claude": "claude plugin validate --strict .claude",
    "validate:hooks-catch": "bash scripts/checks/gating-hooks-catch.sh",
    "validate:marketplace": "claude plugin validate --strict .",
    "validate:mods": "bash scripts/checks/plugins.sh mods",
    "validate:plugins": "bash scripts/checks/plugins.sh validate",
    "validate:portable": "bash scripts/checks/plugins.sh portable"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "typescript-language-server": "6.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^12.2.1",
      "onFail": "error"
    }
  }
}
