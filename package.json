{
  "name": "the-claude-factory-maintainer",
  "private": true,
  "description": "Maintainer tooling of the marketplace repository only. Never a runtime of any plugin: plugins ship only their own folder.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerymurillohnd/the-claude-factory.git"
  },
  "scripts": {
    "prepare": "husky",
    "gates": "node scripts/gates.mjs",
    "gates:ci": "node scripts/gates.mjs --ci",
    "test": "node scripts/gates.mjs --only node-tests,pytest-scripts",
    "test:plugins": "node scripts/gates.mjs --only node-tests:,unittest:,by-path:,mod-test:",
    "typecheck": "node scripts/gates.mjs --only tsc-,mod-tsc:,basedpyright-",
    "typecheck:ts": "node scripts/gates.mjs --only tsc-,mod-tsc:",
    "typecheck:python": "node scripts/gates.mjs --only basedpyright-",
    "lint": "node scripts/gates.mjs --only ruff-check-,biome-,shellcheck-,actionlint",
    "lint:python": "node scripts/gates.mjs --only ruff-check-",
    "lint:js": "node scripts/gates.mjs --only biome-",
    "lint:shell": "node scripts/gates.mjs --only shellcheck-",
    "format": "biome check --write --linter-enabled=false . && ruff format . && shfmt -w .",
    "format:check": "node scripts/gates.mjs --only ruff-format-,shfmt-,biome-",
    "fix": "biome check --write . && ruff check --fix . && ruff format . && shfmt -w .",
    "check:repo": "node scripts/gates.mjs --only check-repo",
    "check:version-bump": "node scripts/gates.mjs --only version-bump",
    "generate": "node scripts/generators/marketplace.mjs && node scripts/generators/catalog.mjs",
    "generate:check": "node scripts/gates.mjs --only marketplace,catalog",
    "setup": ".claude/hooks/repo-setup.sh",
    "labels:sync": "node scripts/sync-labels.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "validate": "failed=0; for f in scripts/validators/*.py; do \"$f\" || failed=1; done; exit $failed",
    "validate:lsp-json-schema": "scripts/validators/lsp-json-schema.py",
    "validate:marketplace-json-schema": "scripts/validators/marketplace-json-schema.py",
    "validate:mcp-json-schema": "scripts/validators/mcp-json-schema.py",
    "validate:plugin-json-schema": "scripts/validators/plugin-json-schema.py",
    "validate:plugin-names-consistency": "scripts/validators/plugin-names-consistency.py",
    "validate:plugin-required-files": "scripts/validators/plugin-required-files.py",
    "validate:plugin-versions-consistency": "scripts/validators/plugin-versions-consistency.py",
    "validate:readme-catalog-consistency": "scripts/validators/readme-catalog-consistency.py",
    "validate:skill-names-consistency": "scripts/validators/skill-names-consistency.py",
    "validate:skill-references": "scripts/validators/skill-references.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "typescript": "6.0.3"
  }
}
