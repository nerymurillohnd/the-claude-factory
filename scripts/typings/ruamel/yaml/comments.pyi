class LineCol:
    def key(self, k: object) -> tuple[int, int]: ...
    def value(self, k: object) -> tuple[int, int]: ...
    def item(self, idx: int) -> tuple[int, int]: ...

class CommentedMap(dict[object, object]):
    @property
    def lc(self) -> LineCol: ...

class CommentedSeq(list[object]):
    @property
    def lc(self) -> LineCol: ...
