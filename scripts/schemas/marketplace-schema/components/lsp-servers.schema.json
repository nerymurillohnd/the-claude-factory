{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components/lsp-servers.schema.json",
  "description": "LSP server definitions: path to a .json file, inline map of server name to config, or a list mixing both.",
  "anyOf": [
    {
      "$ref": "../common.schema.json#/$defs/relJsonPath"
    },
    {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/lspServerConfig"
      }
    },
    {
      "type": "array",
      "description": "List of paths / inline maps.",
      "items": {
        "anyOf": [
          {
            "$ref": "../common.schema.json#/$defs/relJsonPath"
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/lspServerConfig"
            }
          }
        ]
      }
    }
  ],
  "x-doc": "https://code.claude.com/docs/en/plugins/manifest-reference#component-path-forms",
  "$defs": {
    "lspServerConfig": {
      "type": "object",
      "description": "One LSP server.",
      "properties": {
        "command": {
          "type": "string",
          "description": "LSP binary to execute (must be on PATH). The CLI rejects a command containing spaces: pass arguments in args. Claude Code rejects a value with a space unless it starts with `/`.",
          "minLength": 1,
          "pattern": "^(/[\\s\\S]*|[^ ]+)$"
        },
        "extensionToLanguage": {
          "type": "object",
          "description": "Maps file extensions (with leading dot) to language identifiers; at least one mapping.",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^\\..+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "args": {
          "type": "array",
          "description": "Command-line arguments.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transport": {
          "type": "string",
          "description": "stdio (default) or socket; Claude Code runs every server over stdio.",
          "enum": [
            "stdio",
            "socket"
          ],
          "default": "stdio"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables."
        },
        "initializationOptions": {
          "description": "Options passed during initialization."
        },
        "settings": {
          "description": "Settings passed via workspace/didChangeConfiguration."
        },
        "workspaceFolder": {
          "type": "string",
          "description": "Workspace folder path."
        },
        "startupTimeout": {
          "type": "integer",
          "description": "Max startup wait in milliseconds.",
          "minimum": 1
        },
        "shutdownTimeout": {
          "type": "integer",
          "description": "Max graceful-shutdown wait in milliseconds (v2.1.205+).",
          "minimum": 1
        },
        "requestTimeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 60000,
          "description": "Milliseconds to wait for the server to answer a request (v2.1.288+). Defaults to 60000.",
          "x-doc": "https://code.claude.com/docs/en/plugins/manifest-reference#lspservers; changelog 2.1.288"
        },
        "restartOnCrash": {
          "type": "boolean",
          "description": "Restart after a crash (default true; v2.1.205+).",
          "default": true
        },
        "maxRestarts": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum restart attempts."
        },
        "diagnostics": {
          "type": "boolean",
          "description": "Push diagnostics into Claude's context after edits (default true).",
          "default": true
        }
      },
      "required": [
        "command",
        "extensionToLanguage"
      ],
      "additionalProperties": false,
      "x-doc": "https://code.claude.com/docs/en/plugins/components#lsp-servers"
    }
  }
}
