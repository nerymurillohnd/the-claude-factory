{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components/monitors.schema.json",
  "description": "Monitors: path to a .json file, or an inline array of monitor objects. Names must be unique within the plugin.",
  "anyOf": [
    {
      "$ref": "../common.schema.json#/$defs/relJsonPath"
    },
    {
      "type": "array",
      "description": "Inline monitors.",
      "items": {
        "$ref": "#/$defs/monitor"
      }
    }
  ],
  "x-doc": "https://code.claude.com/docs/en/plugins/manifest-reference#monitors",
  "$defs": {
    "monitor": {
      "type": "object",
      "description": "One background monitor.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Identifier unique within the plugin.",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "description": "Shell command run as a persistent background process; each stdout line is a notification.",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Short summary shown in the task panel and notifications.",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "description": "always (default) starts at session start and plugin reload; on-skill-invoke:<skill-name> starts on first dispatch of that skill.",
          "pattern": "^(always|on-skill-invoke:.+)$",
          "default": "always"
        }
      },
      "required": [
        "name",
        "command",
        "description"
      ],
      "additionalProperties": false,
      "x-doc": "https://code.claude.com/docs/en/plugins/manifest-reference#monitors"
    }
  }
}
