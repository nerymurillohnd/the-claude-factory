{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "include": [
    "../plugins/**/*.js",
    "../plugins/**/*.cjs",
    "../plugins/**/*.mjs",
    "../plugins/**/*.jsx",
    "../plugins/**/*.ts",
    "../plugins/**/*.cts",
    "../plugins/**/*.mts",
    "../plugins/**/*.tsx"
  ],
  "exclude": [
    "../plugins/*/hooks/**/*.ts",
    "../plugins/*/hooks/**/*.tsx",
    "../plugins/*/tests/**/*.ts",
    "../plugins/*/tests/**/*.tsx",
    "../plugins/*/.claude-plugin",
    "../plugins/*/node_modules",
    // Workflow scripts run as the body of an async function, with a top-level return and injected
    // globals (agent, parallel, pipeline, phase, log, args); scripts/testers/<plugin>/workflow.test.mjs
    // checks them instead.
    "../plugins/*/workflows/**"
  ]
}
