{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "include": [
    "../plugins/**/*.js",
    "../plugins/**/*.cjs",
    "../plugins/**/*.mjs",
    "../plugins/**/*.jsx",
    "../plugins/**/*.ts",
    "../plugins/**/*.cts",
    "../plugins/**/*.mts",
    "../plugins/**/*.tsx"
  ],
  "exclude": [
    "../plugins/*/hooks/**/*.ts",
    "../plugins/*/hooks/**/*.tsx",
    "../plugins/*/tests/**/*.ts",
    "../plugins/*/tests/**/*.tsx",
    "../plugins/*/.claude-plugin"
  ]
}
