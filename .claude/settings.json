{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.1,
  "skillListingMaxDescChars": 2048,
  "enableAllProjectMcpServers": true,
  "syncClaudeAiSkills": true,
  "syncClaudeAiPlugins": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1"
  },
  "permissions": {
    "allow": [
      "Agent",
      "AskUserQuestion",
      "Bash(.claude/skills/documentation-governance/scripts/check-document.sh *)",
      "Bash(claude plugin details *)",
      "Bash(claude plugin list*)",
      "Bash(claude plugin validate *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh label list*)",
      "Bash(gh release list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(git commit *)",
      "Bash(kill *)",
      "Bash(node --test *)",
      "Bash(node scripts/*)",
      "Bash(npm run gates)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Edit(/plugins/*/CHANGELOG.md)",
      "Edit(/plugins/*/README.md)",
      "Grep",
      "LSP",
      "Monitor",
      "WebFetch",
      "WebSearch",
      "Workflow"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(gh repo delete*)",
      "Bash(pip *)",
      "Bash(pip3*)",
      "Bash(python* -m pip *)",
      "Bash(uv pip *)"
    ]
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    }
  ],
  "enableWorkflows": true,
  "enabledPlugins": {
    "plugin-evals@the-claude-factory": true,
    "project-maintainer@the-claude-factory": true,
    "github-operations@the-claude-factory": true,
    "bash-lsp-intelligence@the-claude-factory": true,
    "python-lsp-intelligence@the-claude-factory": true,
    "typescript6-lsp-intelligence@the-claude-factory": true,
    "hook-engineering@the-claude-factory": true,
    "instruction-engineering@the-claude-factory": true,
    "forestal-mt@forestal-mt": false,
    "forestal-mt@synced": false,
    "forestal-mt@inline": false,
    "frontend-design@claude-plugins-official": false,
    "frontend-design@synced": false,
    "frontend-design@inline": false,
    "mcp-server-dev@claude-plugins-official": true
  },
  "autoMemoryDirectory": "~/Claude/repositories/the-claude-factory/.claude/memory",
  "autoMemoryEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-owner-gate.sh",
            "args": []
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-check.sh",
            "args": [
              "--hook"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-pending.sh",
            "args": [
              "--hook"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "changelog-writer|plugin-readme-writer",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-check.sh",
            "args": [
              "--hook"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-pending.sh",
            "args": [
              "--hook"
            ]
          }
        ]
      }
    ]
  }
}
