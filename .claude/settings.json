{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node .github/scripts/*)",
      "Bash(node --test *)",
      "Bash(.github/scripts/validate-claude.sh)",
      "Bash(npx --yes markdownlint-cli2@*)",
      "Bash(claude plugin validate *)",
      "Bash(claude plugin details *)",
      "Bash(claude plugin list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh label list*)",
      "Bash(gh release list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git tag *)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh repo delete*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checkout.sh"
          }
        ]
      }
    ]
  },
  "autoMemoryDirectory": "~/Claude/the-claude-factory/.claude/memory",
  "enabledPlugins": {
    "plugin-evals@the-claude-factory": true
  }
}
