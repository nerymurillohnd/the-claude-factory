{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/*)",
      "Bash(node --test *)",
      "Bash(npm run gates)",
      "Bash(claude plugin validate *)",
      "Bash(claude plugin details *)",
      "Bash(claude plugin list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh label list*)",
      "Bash(gh release list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(gh repo delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/version-bump-gate.sh",
            "args": [],
            "if": "Bash(git push *)",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validators-gate.sh",
            "args": [],
            "if": "Bash(git push*)",
            "timeout": 120,
            "statusMessage": "Running the maintainer validators before the push…",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checkout.sh",
            "timeout": 180,
            "statusMessage": "Syncing node_modules, running the validators and checking tool versions…"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "plugin-evals@the-claude-factory": true,
    "forestal-mt@forestal-mt": false,
    "forestal-mt@synced": false
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    }
  ],
  "autoMemoryDirectory": "~/Claude/repositories/the-claude-factory/.claude/memory"
}
