{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(node .github/scripts/*)",
      "Bash(node --test *)",
      "Bash(.github/scripts/validate-claude.sh)",
      "Bash(npx --yes markdownlint-cli2@*)",
      "Bash(claude plugin validate *)",
      "Bash(claude plugin details *)",
      "Bash(claude plugin list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh label list*)",
      "Bash(gh release list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(gh repo delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/version-bump-gate.sh",
            "args": [],
            "if": "Bash(git push *)",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checkout.sh"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "plugin-evals@the-claude-factory": true
  },
  "autoMemoryDirectory": "~/Claude/repositories/the-claude-factory/.claude/memory"
}
