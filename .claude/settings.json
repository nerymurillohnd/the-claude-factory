{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.1,
  "skillListingMaxDescChars": 2048,
  "syncClaudeAiSkills": true,
  "syncClaudeAiPlugins": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_AUTO_MODE_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_BASH_EDIT_DIFF": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "120000",
    "CLAUDE_CODE_GLOB_HIDDEN": "true",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "true",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "true"
  },
  "permissions": {
    "allow": [
      "Bash(node --test *)",
      "Bash(claude plugin validate *)",
      "Bash(claude plugin details *)",
      "Bash(claude plugin list*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh label list*)",
      "Bash(gh release list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "WebFetch",
      "WebSearch",
      "Monitor",
      "LSP",
      "Workflow",
      "Agent",
      "AskUserQuestion",
      "Grep",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(python3 *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(ruff *)",
      "Bash(basedpyright *)",
      "Bash(npx biome *)",
      "Bash(npx tsc *)",
      "Bash(shfmt *)",
      "Bash(shellcheck *)",
      "Bash(actionlint *)",
      "Bash(zizmor *)",
      "Bash(bash scripts/validators/pre-commit-gate.sh)",
      "Bash(bash scripts/validators/pr-checks.sh *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(tsc *)",
      "Bash(biome *)",
      "Bash(uv run *)",
      "Bash(python3 -c *)",
      "Bash(node *)",
      "Bash(nvm *)",
      "ExitPlanMode",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "Bash(awk *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(jq *)",
      "Bash(tree *)",
      "Bash(kill *)",
      "Bash(git *)",
      "mcp__Claude_Code_Docs__*",
      "mcp__Context7__*",
      "Skill(*)",
      "EnterPlanMode",
      "TaskCreate",
      "Update",
      "Bash(agent:*)",
      "Bash(plugin:*)",
      "Bash(claude plugin*)",
      "Bash(claude agents*)",
      "ToolSearch",
      "WebSearch(*)",
      "WebFetch(*)",
      "Agent(*)",
      "Read",
      "Edit",
      "Write",
      "Bash"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git *--no-verify*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh release create*)",
      "Bash(claude plugin tag * --push*)",
      "Bash(claude plugin eval*)",
      "Bash(npm run labels:sync -- --apply*)",
      "Edit(/.claude/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/package.json)",
      "Edit(/pyproject.toml)",
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.shellcheckrc)",
      "Edit(/biome.jsonc)",
      "Edit(/tsconfig.json)",
      "Edit(/tsconfig.base.json)",
      "Edit(/.editorconfig)",
      "Edit(/.github/zizmor.yml)",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__create_branch",
      "mcp__github__actions_run_trigger",
      "mcp__github__enable_pr_auto_merge",
      "mcp__Github_MCP_Server__create_pull_request",
      "mcp__Github_MCP_Server__create_pull_request_with_copilot",
      "mcp__Github_MCP_Server__merge_pull_request",
      "mcp__Github_MCP_Server__push_files",
      "mcp__Github_MCP_Server__create_or_update_file",
      "mcp__Github_MCP_Server__delete_file",
      "mcp__Github_MCP_Server__create_branch",
      "mcp__Github_MCP_Server__actions_run_trigger",
      "mcp__Github_MCP_Server__label_write"
    ],
    "deny": [
      "Bash(gh repo delete*)",
      "Bash(pip *)",
      "Bash(pip3*)",
      "Bash(python* -m pip *)",
      "Bash(uv pip *)",
      "Bash(* pip *)",
      "Edit(/uv.lock)",
      "Edit(/package-lock.json)",
      "mcp__Github_MCP_Server__delete_repository",
      "mcp__*Gmail__*",
      "mcp__*Google_Drive__*",
      "mcp__*Google_Calendar__*",
      "mcp__*Google_Sheets__*",
      "mcp__*Google_Docs__*",
      "mcp__*Astro_docs__*",
      "mcp__*cloudflare__*",
      "mcp__*Cloudflare__*",
      "mcp__*svelte__*",
      "mcp__*Svelte__*"
    ]
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Drive"
    },
    {
      "serverName": "claude.ai Google Calendar"
    },
    {
      "serverName": "claude.ai Google Sheets"
    },
    {
      "serverName": "claude.ai Google Docs"
    },
    {
      "serverName": "claude.ai Astro docs"
    },
    {
      "serverName": "claude.ai Cloudflare"
    },
    {
      "serverName": "claude.ai Svelte"
    },
    {
      "serverName": "Gmail"
    },
    {
      "serverName": "Google_Drive"
    },
    {
      "serverName": "Google_Calendar"
    },
    {
      "serverName": "Google_Sheets"
    },
    {
      "serverName": "Google_Docs"
    },
    {
      "serverName": "Astro_docs"
    },
    {
      "serverName": "cloudflare"
    },
    {
      "serverName": "svelte"
    }
  ],
  "skillOverrides": {
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off"
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "plugin-evals@the-claude-factory": true,
    "project-maintainer@the-claude-factory": true,
    "github-operations@the-claude-factory": true,
    "bash-lsp-intelligence@the-claude-factory": true,
    "python-lsp-intelligence@the-claude-factory": true,
    "typescript6-lsp-intelligence@the-claude-factory": true,
    "hook-engineering@the-claude-factory": true,
    "instruction-engineering@the-claude-factory": true,
    "forestal-mt@forestal-mt": false,
    "forestal-mt@synced": false,
    "forestal-mt@inline": false,
    "frontend-design@claude-plugins-official": false,
    "frontend-design@synced": false,
    "frontend-design@inline": false,
    "superpowers@synced": false,
    "cloudflare@synced": false,
    "feature-dev@synced": false,
    "svelte-development@synced": false,
    "tailwind-development@synced": false,
    "pdf-viewer@synced": false,
    "mcp-server-dev@claude-plugins-official": true,
    "skill-diagnostics@the-claude-factory": false,
    "plugin-engineering@the-claude-factory": true,
    "skills-engineering@the-claude-factory": true,
    "work-lifecycle@the-claude-factory": true
  },
  "autoMemoryEnabled": true,
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "the-claude-factory": {
      "source": {
        "source": "github",
        "repo": "nerymurillohnd/the-claude-factory"
      },
      "autoUpdate": true
    }
  }
}
