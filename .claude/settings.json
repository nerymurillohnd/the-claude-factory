{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.1,
  "skillListingMaxDescChars": 2048,
  "syncClaudeAiSkills": true,
  "syncClaudeAiPlugins": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(node --test *)",
      "Bash(claude plugin validate *)",
      "Bash(claude plugin details *)",
      "Bash(claude plugin list*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh label list*)",
      "Bash(gh release list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "WebFetch",
      "WebSearch",
      "Monitor",
      "LSP",
      "Workflow",
      "Agent",
      "AskUserQuestion",
      "Grep",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(kill *)",
      "Bash(git commit *)",
      "mcp__Claude_Code_Docs__*",
      "mcp__Context7__*"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh release create*)",
      "Bash(claude plugin tag * --push*)",
      "Bash(npm run labels:sync -- --apply*)",
    "Edit(/.claude/CLAUDE.md)",
    "Edit(/.claude/settings.json)",
    "Edit(/.claude/settings.local.json)",
    "Edit(/package.json)",
    "Edit(/pyproject.toml)",
    "Edit(/.github/workflows/**)",
    "Edit(/scripts/validators/**)",
    "Edit(/scripts/checkers/**)",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__create_branch",
      "mcp__github__actions_run_trigger",
      "mcp__github__enable_pr_auto_merge",
      "mcp__Github_MCP_Server__create_pull_request",
      "mcp__Github_MCP_Server__create_pull_request_with_copilot",
      "mcp__Github_MCP_Server__merge_pull_request",
      "mcp__Github_MCP_Server__push_files",
      "mcp__Github_MCP_Server__create_or_update_file",
      "mcp__Github_MCP_Server__delete_file",
      "mcp__Github_MCP_Server__create_branch",
      "mcp__Github_MCP_Server__actions_run_trigger",
      "mcp__Github_MCP_Server__label_write"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(gh repo delete*)",
      "Bash(pip *)",
      "Bash(pip3*)",
      "Bash(python* -m pip *)",
      "Bash(uv pip *)",
      "Edit(/uv.lock)",
      "Edit(/package-lock.json)",
    "Edit(/ruff.toml)",
    "Edit(/.shellcheckrc)",
    "Edit(/biome.jsonc)",
    "Edit(/pyrightconfig.json)",
    "Edit(/scripts/pyrightconfig.json)",
    "Edit(/tsconfig.json)",
    "Edit(/tsconfig.base.json)",
    "Edit(/.editorconfig)",
    "Edit(/.github/zizmor.yml)",
      "mcp__Github_MCP_Server__delete_repository"
    ]
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    }
  ],
  "enableWorkflows": true,
  "enabledPlugins": {
    "plugin-evals@the-claude-factory": true,
    "project-maintainer@the-claude-factory": true,
    "github-operations@the-claude-factory": true,
    "bash-lsp-intelligence@the-claude-factory": true,
    "python-lsp-intelligence@the-claude-factory": true,
    "typescript6-lsp-intelligence@the-claude-factory": true,
    "hook-engineering@the-claude-factory": true,
    "instruction-engineering@the-claude-factory": true,
    "forestal-mt@forestal-mt": false,
    "forestal-mt@synced": false,
    "forestal-mt@inline": false,
    "frontend-design@claude-plugins-official": false,
    "frontend-design@synced": false,
    "frontend-design@inline": false,
    "superpowers@synced": false,
    "cloudflare@synced": false,
    "feature-dev@synced": false,
    "svelte-development@synced": false,
    "tailwind-development@synced": false,
    "pdf-viewer@synced": false,
    "mcp-server-dev@claude-plugins-official": true,
    "skill-diagnostics@the-claude-factory": true,
    "plugin-engineering@the-claude-factory": true
  },
  "autoMemoryEnabled": true,
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "the-claude-factory": {
      "source": {
        "source": "github",
        "repo": "nerymurillohnd/the-claude-factory"
      },
      "autoUpdate": true
    }
  }
}
