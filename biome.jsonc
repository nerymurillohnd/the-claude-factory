// The maintainers' Biome configuration. Each setting that differs from Biome's default says why
// beside it. Everything else is left to Biome's defaults and its recommended preset.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    // Applies .gitignore, including the nested one that hides each mod's generated
    // .claude-plugin/types/; defaultBranch is the base of --changed.
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    // An unknown file type is an error, never skipped in silence.
    "ignoreUnknown": false,
    "includes": [
      // Every extension the repository holds that Biome reads.
      "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,md,yml,yaml}",
      // Build output.
      "!!**/dist",
      "!!**/build",
      // Worktrees are full checkouts with their own root configuration.
      "!!.claude/worktrees",
      // The superpowers plugin's local working folder (git-ignored).
      "!!.superpowers",
      // .claude/CLAUDE.md keeps .github/ out of the maintainer tools; actionlint checks the workflows.
      "!!.github",
      // Personal, git-ignored.
      "!!.claude/settings.local.json",
      // Its {{…}} placeholders are not JSON until rendered.
      "!.claude/skills/building-plugins/assets/plugin-template.json",
      // npm writes it.
      "!!**/package-lock.json",
      // The engine's generated types, git-ignored but still indexed by the Scanner, and the largest
      // files it would read. Biome cannot use them: the mods reach them through typeRoots and an
      // ambient declare module 'claude-code', which Biome does not resolve; tsc -p still reads them.
      // Drop this once Biome resolves ambient modules and noUnresolvedImports stops flagging the
      // mods' claude-code imports.
      "!!plugins/*/.claude-plugin/types",
      // Markdown Biome never formats: ADR_2026-10-26_biome-never-formats-plugin-and-skill-markdown.
      "!**/CLAUDE.md",
      "!.claude/memory",
      "!.claude/session-handoff",
      "!.claude/maintainer",
      "!.claude/plans",
      "!.claude/specs",
      "!.claude/rules",
      "!.claude/skills/**/*.md",
      "!plugins/**/*.md"
    ]
  },
  "assist": {
    // Assist is on and runs its recommended actions (organizeImports) by default, and biome ci
    // fails when one has a change to make. Each action added here gets its
    // source.action.<action>.biome line in .vscode/settings.json, so saving applies it too.
    "actions": {
      "source": {
        // package.json fields in sort-package-json's conventional order.
        "useSortedPackageJson": "on",
        // A repeated class in a mod's JSX className.
        "noDuplicateClasses": "on"
      }
    }
  },
  "formatter": {
    // Nery's standard line width, the same as ruff.toml.
    "lineWidth": 100,
    // .editorconfig is the only source of indentation and line endings.
    "useEditorconfig": true
  },
  "linter": {
    // The preset plus Nery's rule set: each entry raises a severity, turns on a rule the preset
    // leaves off, or turns one off. The gates fail on warnings (--error-on-warnings).
    // The tests run on node:test, which Biome does not detect, so the test domain's recommended
    // rules are turned on by hand.
    "domains": {
      "test": "recommended"
    },
    // The project and types domains' recommended sets catch neither an import cycle nor a floating
    // promise here, so the rules that do are listed one by one below. Any of them starts the
    // Scanner across the whole repository, for every run and every editor session.
    "rules": {
      "preset": "recommended",
      "correctness": {
        // Not recommended, but it would report the mods' imports of the engine's claude-code module,
        // which no package.json declares, if a project-domain setting ever turned it on.
        "noUndeclaredDependencies": "off",
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error",
        "noChildrenProp": "error",
        // Scanner: an import of another module's private (@private, @package) export.
        "noPrivateImports": "error",
        // Raised from info, like the complexity rules above.
        "useParseIntRadix": "error"
      },
      "complexity": {
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        // Info-level rules of the preset, raised: info never fails the CLI, even with
        // --error-on-warnings, so at info they would print and block nothing.
        "noFlatMapIdentity": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        // Off: tsc's noPropertyAccessFromIndexSignature (tsconfig.base.json) already decides how an
        // index-signature key is written, and requires the bracket form this rule rewrites.
        "useLiteralKeys": "off"
      },
      "performance": {
        "noDelete": "error"
      },
      "style": {
        "noImplicitBoolean": "error",
        "noParameterAssign": "warn",
        "noRestrictedGlobals": "error",
        "noShoutyConstants": "warn",
        "noUnusedTemplateLiteral": "warn",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "warn",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useExponentiationOperator": "error",
        "useNumberNamespace": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "warn",
        "useConsistentArrayType": "error",
        "useForOf": "error",
        "useImportType": "error",
        "useNamingConvention": "warn",
        // Raised from info, like the complexity rules above.
        "useArrayLiterals": "error",
        "useNodejsImportProtocol": "error",
        "useShorthandFunctionType": "error",
        // A JSON file whose top level is not an object or an array.
        "noTopLevelLiterals": "error"
      },
      "suspicious": {
        "noCatchAssign": "error",
        "noConsole": "warn",
        "noEmptyBlockStatements": "error",
        "noExtraNonNullAssertion": "error",
        "noPrototypeBuiltins": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "warn",
        "useAdjacentOverloadSignatures": "error",
        // Scanner: import cycles, and imports of a symbol marked @deprecated.
        "noImportCycles": "error",
        "noDeprecatedImports": "error",
        // Raised from info, like the complexity rules above.
        "noDuplicateFields": "error",
        "noQuickfixBiome": "error",
        // From the test domain's full set: an expect inside an if can be skipped without failing.
        "noConditionalExpect": "error",
        // package.json and JSON checks the preset leaves off: a dependency listed twice, an empty
        // file or YAML document, and a "" key.
        "noDuplicateDependencies": "error",
        "noEmptySource": "error",
        "noEmptyObjectKeys": "error",
        // Every maintenance command is an npm run script (.claude/CLAUDE.md). The rule takes exact
        // names, so the check:* family stays outside it.
        "useRequiredScripts": {
          "level": "error",
          "options": {
            "requiredScripts": [
              "test",
              "typecheck",
              "lint",
              "format",
              "fix",
              "validate",
              "gates",
              "setup",
              "generate"
            ]
          }
        }
      },
      // The preset never turns on a nursery rule, so each one is listed.
      "nursery": {
        // Scanner: a module that imports itself.
        "noSelfImport": "error",
        // Scanner, with type inference: a dropped promise fails without a trace in an async hook.
        // These see only the promise types Biome infers inside the repository, not @types/node's.
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "useExplicitType": "warn",
        "useConsistentHeadingLevel": "error",
        "useFencedCodeLanguage": "error",
        "useSingleTopLevelHeading": "error",
        // Each Markdown document starts with a level-1 heading (or an HTML block, as READMEs do),
        // and none starts with a byte order mark, which UTF-8 does not need.
        "useTopLevelHeading": "error",
        "useConsistentUnicodeBom": "error",
        // An import with a native or modern replacement, from e18e's data.
        "noRestrictedDependencies": "error",
        // new require(…) is always a mistake. Its sibling noUnsafeReturn stays off: in .mjs it ignores
        // JSDoc types and type guards, so it flags JSON that is already validated.
        "noNewRequire": "error",
        // The other nursery rules `biome explain` marks as recommended on 2.6.3. Nursery rules are
        // outside semver: each Biome upgrade rechecks this list (the version is pinned, and
        // Dependabot proposes each upgrade as its own pull request).
        "noAccidentalBitwiseOperators": "error",
        "noArgumentsCallerOrCallee": "error",
        "noArraySortForMinMax": "error",
        "noBooleanSortComparator": "error",
        "noDoubleComparison": "error",
        // The only YAML rule: without it, the YAML linter runs no rule.
        "noDuplicateMapKeys": "error",
        "noEagerArrayMethodsInLoops": "error",
        "noImpliedEval": "error",
        "noInvalidPropertyInitValue": "error",
        "noJsonUnsafeValues": "error",
        "noMisplacedListElements": "error",
        "noObsoleteAttributes": "error",
        "noOctal": "error",
        "noPathConcat": "error",
        "noReturnInFinally": "error",
        "noUnsafeIframeSandbox": "error",
        "noUselessAssignment": "error",
        "noUselessCall": "error",
        "noUselessDateGetTime": "error",
        "noUselessSplice": "error",
        "noXorAsExponentiation": "error",
        "noZeroLengthUnit": "error",
        "useBigintLiterals": "error",
        "useBlockStatementOverIife": "error",
        "useCapitalizedConstructors": "error",
        "useConsistentObjectKeys": "error",
        "useFlatMathMinMax": "error",
        "useMathAbs": "error",
        "useMathTrunc": "error",
        "useModernMathApis": "error",
        "usePackageJsonValidCpu": "error",
        "usePackageJsonValidEngines": "error",
        "useSimplifiedBooleanReturn": "error",
        "useUnaryMinus": "error"
      }
    }
  },
  "javascript": {
    // Nery's standard: single quotes, semicolons only where needed.
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    },
    // Node runs the .js, .mjs and .cjs files, never as JSX.
    "parser": {
      "jsxEverywhere": false
    }
  },
  "json": {
    // The scripts write JSON with JSON.stringify(…, 2), which always expands.
    "formatter": {
      "expand": "always"
    }
  },
  "markdown": {
    // Without it, Biome breaks a document's frontmatter by inserting a blank line after the
    // opening ---.
    "parser": {
      "frontmatter": true
    }
  },
  "overrides": [
    {
      // Tests print, test booleans directly, and use the hook protocol's snake_case keys.
      "includes": [
        "**/tests/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noImplicitBoolean": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      // Console output is the scripts' interface.
      "includes": [
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      // No script writes a tsconfig, so "always" has no reason here, and "auto" checks every
      // tsconfig without reformatting the plugins' ones:
      // ADR_2026-10-27_biome-checks-every-tsconfig-with-auto-expand.
      "includes": [
        "**/tsconfig.json",
        "**/tsconfig.*.json"
      ],
      "json": {
        "formatter": {
          "expand": "auto"
        }
      }
    }
  ]
}
