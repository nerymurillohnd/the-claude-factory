root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Shell style for shfmt (every key replaces one flag): -i 2 -s -bn -ci -sr.
[[shell]]
indent_style = space
indent_size = 2
simplify = true
binary_next_line = true
switch_case_indent = true
space_redirects = true
